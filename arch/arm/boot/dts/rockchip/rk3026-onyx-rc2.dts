// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ONYX BOOX Robinson Crusoe 2 (MC_Kepler_R2, pcb V1.73), RK3026, 512 MiB DDR3.
 *
 * First-light description. The board boots from the microSD slot through a
 * loader that hands over like the stock RK3026 loader: r2 = ATAG list (core +
 * cmdline, no ATAG_MEM), MMU and caches off, PLLs, PMIC and DDR as the DDR
 * init left them, CPU1 held in reset, IMEM mapped at 0 (GRF_SOC_CON0 bit 12),
 * power hold (GPIO1_A2) high. The DTB is appended to the zImage.
 *
 * Power-off drops the power hold: on battery the ACT8931 then switches every
 * rail off, as the stock kernel's last power-off step does. With USB power
 * present the board stays up and the kernel waits with the hold low, so
 * unplugging the cable switches it off.
 *
 * Deliberately left out until each part is checked on the board:
 *  - the eMMC (0x1021c000) and the NAND controller (0x10500000): the NFC pads
 *    are the eMMC data lines on this board. Both nodes are deleted;
 *  - control of the ACT8931 (i2c0 0x5b) beyond the CPU supply: its other
 *    rails are described as fixed regulators at the voltages the chip
 *    holds, and its node in rk3026-onyx-rc2-sys.dtsi keeps every output
 *    but DCDC3 at that voltage (the act8865 driver, a module loaded after
 *    /init). The one ACT8931 write the panel needs, LDO4 (the panel logic
 *    rail, off at power-on) on, comes from /init before the EBC driver is
 *    loaded;
 *  - audio, Bluetooth;
 *
 * The panel: the EBC with the stock ED060 1448x1072 timings and the TPS65185
 * EPD PMIC on i2c2, whose high-voltage rails and VCOM the EBC driver switches
 * on only around refreshes. The touch controller shares i2c2 with it.
 *
 * cpufreq scales voltage and frequency: the CPUs' supply is ACT8931 DCDC3,
 * and cpufreq-dt probes once the act8865 module has bound it.
 *
 * System devices (fuel gauge and charger presence, RTC, front light, cover
 * switch, vibrator, Wi-Fi power and the USB host port) are described in
 * rk3026-onyx-rc2-sys.dtsi, included at the end.
 */

/dts-v1/;
#include "rk3026.dtsi"
#include <dt-bindings/input/input.h>

/*
 * CPU operating point voltages, the one place to change them (target =
 * minimum = maximum in each opp-microvolt). The Rockchip RK3026 SDK table
 * (rk3026-tb): 312 MHz 0.95 V, 504 MHz 1.00 V, 816 MHz 1.20 V, 912 MHz
 * 1.25 V, 1008 MHz 1.35 V. Every value must be an ACT8931 DCDC3 step:
 * 0.6 V + 25 mV up to 1.175 V, 1.2 V + 50 mV from there (0.95 V = 0x0e,
 * 1.00 V = 0x10, 1.20 V = 0x18, 1.30 V = 0x1a, 1.35 V = 0x1b), and at
 * most 1.40 V (0x1c, the SoC's absolute maximum).
 */
#define RC2_OPP_UV_312		950000
#define RC2_OPP_UV_504		1000000
#define RC2_OPP_UV_816		1200000
/*
 * 912 MHz: one step above the SDK's 1.25 V. A frequency x voltage sweep of
 * this board (2026-10-19, 24 degC) passed 912 MHz at 1.25 V and hung at
 * 1.20 V, so 1.25 V has no margin on it.
 */
#define RC2_OPP_UV_912		1300000
#define RC2_OPP_UV_1008		1350000
/*
 * DCDC3 ramp for a raise, uV/us: the ACT8931 datasheet gives no slew rate
 * for a VSET change, so a conservative 0.5 mV/us (0.95 -> 1.30 V: 700 us).
 */
#define RC2_VDD_ARM_RAMP	500

/delete-node/ &emmc;
/delete-node/ &nfc;

/ {
	model = "Onyx Boox Robinson Crusoe 2";
	compatible = "onyx,rc2", "rockchip,rk3026";

	aliases {
		mmc0 = &sdmmc;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>; /* 512 MiB */
	};

	/*
	 * The top 1 MiB is the stock waveform window: the stock kernel keeps it
	 * out of its RAM, the loader puts the waveform at its start and its own
	 * text log at 0x7fff0000. The part in between is unused by the stock
	 * kernel, so the ramoops buffer there can be read back after a reset
	 * from either kernel.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		waveform@7ff00000 {
			reg = <0x7ff00000 0x40000>;
			no-map;
		};

		ramoops@7ff40000 {
			compatible = "ramoops";
			reg = <0x7ff40000 0x80000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
		};

		loader-log@7ffc0000 {
			reg = <0x7ffc0000 0x40000>;
			no-map;
		};

		/*
		 * EBC images (two 4 bpp frames of 776 128 B, adjacent), 10 MiB
		 * as on the C67ML, right below the top MiB so it stays clear of
		 * the waveform, ramoops and loader windows. U-Boot puts the FDT
		 * and an initrd below 0x70000000.
		 */
		ebc_reserved: ebc@7f500000 {
			compatible = "shared-dma-pool";
			reg = <0x7f500000 0xa00000>;
			no-map;
		};
	};

	cpus {
		/* The loader sets the IMEM remap and holds CPU1 in reset. */
		enable-method = "rockchip,rk3036-smp";
	};

	/*
	 * The Rockchip SDK's operating points, voltages above. cpufreq-dt
	 * raises the voltage before the frequency and lowers it after.
	 * The loader leaves the CPU at 600 MHz and DCDC3 at 1.40 V; 600 MHz
	 * is not in the table, so the cpufreq core moves the policy to the
	 * next rate up when it starts, 816 MHz, setting 1.20 V first (600 MHz
	 * at 1.20 V is inside what the sweep passed). 816 MHz is also the
	 * suspend point, which the cpufreq core sets before a reboot or a
	 * power-off: the loader then starts at 600 MHz with 1.20 V. 1008 MHz
	 * is a boost point, off until /sys/devices/system/cpu/cpufreq/boost
	 * is set.
	 */
	cpu_opp_table: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-312000000 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <RC2_OPP_UV_312 RC2_OPP_UV_312 RC2_OPP_UV_312>;
		};

		opp-504000000 {
			opp-hz = /bits/ 64 <504000000>;
			opp-microvolt = <RC2_OPP_UV_504 RC2_OPP_UV_504 RC2_OPP_UV_504>;
		};

		opp-816000000 {
			opp-hz = /bits/ 64 <816000000>;
			opp-microvolt = <RC2_OPP_UV_816 RC2_OPP_UV_816 RC2_OPP_UV_816>;
			opp-suspend;
		};

		opp-912000000 {
			opp-hz = /bits/ 64 <912000000>;
			opp-microvolt = <RC2_OPP_UV_912 RC2_OPP_UV_912 RC2_OPP_UV_912>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <RC2_OPP_UV_1008 RC2_OPP_UV_1008 RC2_OPP_UV_1008>;
			turbo-mode;
		};
	};

	/*
	 * ACT8931 rails, as fixed regulators at the selectors the chip holds
	 * (VSET2 bank, read on this board). DCDC3 (vdd_arm) is the PMIC
	 * node's, in rk3026-onyx-rc2-sys.dtsi.
	 */
	vcc_io: regulator-vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";		/* DCDC1 */
		regulator-min-microvolt = <3400000>;
		regulator-max-microvolt = <3400000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_ddr: regulator-vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr";		/* DCDC2 */
		regulator-min-microvolt = <1350000>;
		regulator-max-microvolt = <1350000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_tp: regulator-vcc-tp {
		compatible = "regulator-fixed";
		regulator-name = "vcc_tp";		/* LDO1, touch */
		regulator-min-microvolt = <3100000>;
		regulator-max-microvolt = <3100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * The TPS65185's VIN, the battery / charger system rail; nothing
	 * switches it. The voltage is nominal.
	 */
	vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_sd: regulator-vcc-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sd";		/* LDO3, microSD */
		regulator-min-microvolt = <3100000>;
		regulator-max-microvolt = <3100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key &page_keys>;

		key-power {
			label = "Power";
			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-pageup {
			label = "Page Up";
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		key-pagedown {
			label = "Page Down";
			gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};

		key-back {
			label = "Back";
			gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_BACK>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/*
	 * Power hold (ACT8931 PWRHLD): the loader drives it high, the driver
	 * keeps it high from probe on and drives it low to power off. On
	 * battery the PMIC then switches every rail off; the line is not
	 * driven back high while they fall. USB power keeps the board up:
	 * rather than give up after a few seconds and return into a system
	 * whose devices are already shut down, wait with the line low (CPU0
	 * spins with interrupts off, like a halt), so unplugging the cable
	 * switches the board off.
	 */
	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_hold>;
		active-delay-ms = <3000>;
		timeout-ms = <0xffffffff>;
	};

	/*
	 * The panel thermometer in the TPS65185, which selects the waveform
	 * temperature range. No trips: nothing is cooled.
	 */
	thermal-zones {
		epd-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tps65185>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pin>;

		led-0 {
			label = "status";
			gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
			/* dark by default; "heartbeat" via sysfs when a test needs it */
			linux,default-trigger = "none";
			panic-indicator;
		};
	};
};

/*
 * i2c0: ACT8931 at 0x5b, CW2015 at 0x62 and HYM8563 at 0x51, all described
 * in rk3026-onyx-rc2-sys.dtsi. /init makes the one LDO4 write through
 * i2c-dev before the ACT8931's driver can be loaded.
 */
&cpu0 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_arm>;
};

&i2c0 {
	status = "okay";
};

/* i2c2: the TPS65185 EPD PMIC (0x68) and the touch controller (0x24). */
&i2c2 {
	status = "okay";

	/*
	 * No PWRUP and no PWR_GOOD pin on this board: the driver powers the
	 * rails through the ENABLE register and polls PG. WAKEUP is high from
	 * the loader on (the chip answers on a cold boot); VCOM_CTRL is the
	 * vcom regulator's enable. The values below are what the chip holds
	 * (read on this board): VADJ 0x03 = 15 V, VCOM1 0xa6 / VCOM2 b0 = 0 =
	 * 1.66 V in 10 mV steps, ENABLE 0x20 = V3P3 switch on. With min = max
	 * equal to the held value the regulator core reads it back and writes
	 * nothing.
	 *
	 * VADJ and the power sequence are reloaded from the chip's EEPROM on a
	 * WAKEUP rising edge or a power loss, so the driver writes the stock
	 * values at probe: VADJ 3 (15 V, the same value the vposneg constraint
	 * names, so the two never disagree), UPSEQ0/1 0x39 / 0x11 (VDDH, VNEG,
	 * VEE, VPOS), DWNSEQ0/1 0x00 / 0x00 (all rails off together).
	 */
	tps65185: pmic@68 {
		compatible = "ti,tps65185";
		reg = <0x68>;
		vin-supply = <&vcc_sys>;
		wakeup-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		vcom-ctrl-gpios = <&gpio2 RK_PC0 GPIO_ACTIVE_HIGH>;
		#thermal-sensor-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&tps65185_pins>;
		ti,vadj = <3>;
		ti,up-sequence = /bits/ 8 <0x39 0x11>;
		ti,down-sequence = /bits/ 8 <0x00 0x00>;

		regulators {
			/*
			 * The 3.3 V switch is on at idle under the stock
			 * kernel too; always-on keeps the core from switching
			 * it off as unused.
			 */
			v3p3: v3p3 {
				regulator-name = "v3p3";
				regulator-always-on;
			};

			vposneg: vposneg {
				regulator-name = "vposneg";
				regulator-min-microvolt = <15000000>;
				regulator-max-microvolt = <15000000>;
			};

			/* Magnitude: the rail is -1.66 V. */
			vcom: vcom {
				regulator-name = "vcom";
				regulator-min-microvolt = <1660000>;
				regulator-max-microvolt = <1660000>;
			};
		};
	};

	/*
	 * Cypress TrueTouch Gen4. The controller reports X along the short
	 * side of the panel; the stock driver swaps the axes and inverts
	 * its Y, i.e. the controller's X before the swap.
	 */
	touchscreen@24 {
		compatible = "cypress,cyttsp4";
		reg = <0x24>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PA0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&tp_irq &tp_rst>;
		reset-gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vcc_tp>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
	};
};

/*
 * ED060 1448x1072 panel, mounted at 270 degrees. Timings as the stock kernel
 * programs them (source clock 40 MHz: frame 442 x 1082 clocks = 11.96 ms).
 * dclk_ebc runs at four times the source clock, 160 MHz = CPLL 640 MHz / 4,
 * the stock clock tree; CPLL is in slow mode when the loader hands over, so
 * its rate is set here first. No dclk-parent: dclk_ebc is parented to CPLL
 * by assigned-clock-parents, and the driver then only sets the rate it already
 * has. Only the pads the board routes to the EBC: GPIO2_B2 (SDOE) and B4
 * (SDCE2) are board GPIOs here, and GPIO2_C0 (EBC_VCOM) is the TPS65185
 * VCOM_CTRL line.
 */
&ebc {
	clocks = <&cru HCLK_EBC>, <&cru DCLK_EBC>, <&cru ACLK_LCDC1>,
		 <&cru ACLK_EBC>;
	clock-names = "hclk", "dclk", "aclk", "mclk";
	assigned-clocks = <&cru PLL_CPLL>, <&cru DCLK_EBC>;
	assigned-clock-parents = <0>, <&cru PLL_CPLL>;
	assigned-clock-rates = <640000000>, <160000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&ebc_pins_rc2>;
	memory-region = <&ebc_reserved>;
	/*
	 * No v3p3-supply: the panel logic rail is the ACT8931's LDO4, which
	 * /init switches on before the driver loads.
	 */
	epd-supply = <&vposneg>;
	vcom-supply = <&vcom>;
	rockchip,gdck-sta = <100>;
	rockchip,lgonl = <281>;
	rotation = <270>;
	status = "okay";

	panel-timing {
		clock-frequency = <40000000>;
		hactive = <1448>;
		vactive = <1072>;
		hsync-len = <17>;
		hback-porch = <8>;
		hfront-porch = <55>;
		vsync-len = <2>;
		vback-porch = <4>;
		vfront-porch = <4>;
	};
};

&gpu {
	status = "okay";
};

&pinctrl {
	keys {
		pwr_key: pwr-key {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_default>;
		};

		page_keys: page-keys {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_default>,
					<2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_default>,
					<2 RK_PC3 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};

	leds {
		led_pin: led-pin {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	power {
		pwr_hold: pwr-hold {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};

	ebc {
		/*
		 * SDCLK, SDLE, GDCLK (GPIO2_B0, B1, B3), GDOE, GDSP (C1, C2),
		 * GDPWR1, GDPWR2 (D0, D1): the pads stock muxes to the EBC.
		 */
		ebc_pins_rc2: ebc-pins-rc2 {
			rockchip,pins = <2 RK_PB0 2 &pcfg_pull_none>,
					<2 RK_PB1 2 &pcfg_pull_none>,
					<2 RK_PB3 2 &pcfg_pull_none>,
					<2 RK_PC1 2 &pcfg_pull_none>,
					<2 RK_PC2 2 &pcfg_pull_none>,
					<2 RK_PD0 2 &pcfg_pull_none>,
					<2 RK_PD1 2 &pcfg_pull_none>;
		};
	};

	tps65185 {
		/* WAKEUP (GPIO3_C1) and VCOM_CTRL (GPIO2_C0) as GPIOs. */
		tps65185_pins: tps65185-pins {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_default>,
					<2 RK_PC0 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};

	touchscreen {
		tp_irq: tp-irq {
			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		tp_rst: tp-rst {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdmmc {
		/* On eMMC boards the card detect is GPIO2_A3, not GPIO1_C1. */
		sdmmc_cd_gpio: sdmmc-cd-gpio {
			rockchip,pins = <2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};
};

/*
 * The SD clock as the vendor kernel runs it: GPLL 768 MHz / 16 = 48 MHz, so
 * the controller's divider gives 24 MHz on the card for 25 MHz and 400 kHz
 * for identification. Pinned to GPLL so it never follows CPLL, which the EBC
 * driver reprograms.
 */
&sdmmc {
	assigned-clocks = <&cru SCLK_SDMMC>;
	assigned-clock-parents = <&cru PLL_GPLL>;
	assigned-clock-rates = <48000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <25000000>;
	cd-gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
	disable-wp;
	fifo-mode;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4 &sdmmc_cd_gpio>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&usbphy {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

#include "rk3026-onyx-rc2-sys.dtsi"
