# rk3026_android10_ebc.config: the Android 10 test boot on the E Ink panel instead of vkms, on top of
# rk3026_android10_test.config (apply after it). Test-only: not a product configuration.
#
# The display is the EBC driver: it, the GPU (lima) and the ACT8931 stay modules, loaded by the test boot's pre-init
# before Android starts (the EBC first, so that it is card0). No virtual KMS device.
# CONFIG_DRM_VKMS is not set
#
# rk3026_android10_test.config's command line without vkms' preferred-mode tokens; everything else is unchanged.
CONFIG_CMDLINE="console=tty0 console=ttyGS0,115200 fbcon=font:TER16x32 vt.global_cursor_default=0 vt.default_red=255,170,0,170,0,170,0,0,85,255,85,255,85,255,85,0 vt.default_grn=255,0,170,85,0,0,170,0,85,85,255,255,85,85,255,0 vt.default_blu=255,0,0,0,170,170,170,0,85,85,85,85,255,255,255,0 rdinit=/rc2/preinit printk.devkmsg=on androidboot.hardware=opi_pc_go androidboot.selinux=permissive androidboot.boot_devices=loop0,loop1 androidboot.force_normal_boot=1 androidboot.slot_suffix=_a androidboot.verifiedbootstate=orange androidboot.vbmeta.device_state=unlocked androidboot.console=tty1 androidboot.serialno=rc2a10go0001 drm_kms_helper.fbdev_emulation=0"
