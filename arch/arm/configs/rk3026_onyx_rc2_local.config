# Local settings of this tree's RC2 kernels, applied after rk3026_onyx_rc2.config:
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config rk3026_onyx_rc2_local.config
# Not part of the board configuration proposed upstream; keep it out of any
# series. Everything here is a development aid.
#
# Account hard-IRQ and softirq time on their own, so /proc/stat shows the CPU an
# interrupt handler takes (a PIO SD/eMMC host copies its FIFO there). Costs one
# sched_clock read per IRQ entry and exit.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Cheap memory diagnostics: per-area CMA counters in debugfs (used, maxchunk,
# bitmap) and sysfs (alloc_pages_success/fail), at no cost on the hot path, and
# page_owner, which allocates nothing until the kernel is booted with
# page_owner=on (for a CMA allocation that fails with -EBUSY on a page that
# cannot be migrated).
CONFIG_CMA_DEBUGFS=y
CONFIG_CMA_SYSFS=y
CONFIG_PAGE_OWNER=y

# The internal eMMC holds the stock Android install and its loader; writing
# it is the owner's call. Its user area comes up read-only like the boot
# areas (one log line, "user area read-only by default"); lift it for a
# deliberate write with echo 0 > /sys/block/mmcblkN/force_ro. No runtime cost.
CONFIG_MMC_BLOCK_EMMC_DEFAULT_RO=y

# Cheap debug options for the SoC drivers. Each costs a little code and data
# and nothing on a hot path unless noted.
#
# pr_debug()/dev_dbg() switchable at runtime through
# /sys/kernel/debug/dynamic_debug/control: a descriptor per call site (some
# 100 KiB of image), a patched-out branch at each site while it is off.
CONFIG_DYNAMIC_DEBUG=y

# Report a workqueue that has not made progress for 30 s: a timer per CPU.
CONFIG_WQ_WATCHDOG=y

# Check the list pointers on every list_add/list_del: a few compares each.
CONFIG_DEBUG_LIST=y

# Per-IRQ state (chip, domain, trigger, affinity) in /sys/kernel/debug/irq:
# debugfs files only.
CONFIG_GENERIC_IRQ_DEBUGFS=y

# Scheduler statistics in /proc/<pid>/schedstat and /proc/schedstat. Built in
# but off at runtime (a static branch) until kernel.sched_schedstats=1.
CONFIG_SCHEDSTATS=y

# Call a shared IRQ handler once more after free_irq() (driver unbind or a
# failed probe), so a driver that cannot take a late interrupt shows up; a
# stack dump on a shared-flags mismatch. Nothing outside those paths.
CONFIG_DEBUG_SHIRQ=y

# might_sleep() checks: a sleeping call in atomic context is reported. Selects
# PREEMPT_COUNT, so every spin lock and RCU read section counts the preempt
# depth (one increment and decrement each) on this PREEMPT_VOLUNTARY kernel.
CONFIG_DEBUG_ATOMIC_SLEEP=y

# Check scatterlist magic and page alignment on every sg walk: a compare per
# entry, for the DMA drivers (MMC, crypto, VPU, EBC).
CONFIG_DEBUG_SG=y

# VIDIOC_DBG_G/S_REGISTER on the V4L2 drivers (Hantro): register access from
# user space for root, nothing on the streaming path.
CONFIG_VIDEO_ADV_DEBUG=y
