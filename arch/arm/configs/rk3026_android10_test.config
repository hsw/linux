# rk3026_android10_test.config: an Android 10 (GloDroid v0.4.0, Go) userspace on the RK3026 for tests, on top of
# rk3026_android.config (apply after it). Test-only: not a product configuration.
#
# What the Android 10 / 13 userspaces needed beyond rk3026_android.config when booted on this kernel under QEMU:
# SELinux labels on ext4 (system, vendor, data xattrs)
CONFIG_EXT4_FS_SECURITY=y
# vold sets a default ACL on /data/media/<user> when it prepares the user's storage
CONFIG_EXT4_FS_POSIX_ACL=y
# file-based encryption with adiantum (no AES instructions on the Cortex-A9)
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
# AVB hashtree descriptors carry FEC
CONFIG_DM_VERITY_FEC=y
# low-RAM devices swap to zram (fstab zramsize=)
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
# gralloc / codec2 allocate from dma-buf heaps (no ION on mainline), the composer uses sw_sync timelines
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SW_SYNC=y
# named anonymous VMAs (bionic and ART name their mappings; meminfo breakdowns)
CONFIG_ANON_VMA_NAME=y
# netd's bandwidth controller: the quota2 match (Android port on this branch)
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
#
# Display without the panel driver: a virtual KMS device (software GL renders into its dumb buffers); the panel and
# GPU drivers stay modules and are not loaded by the test userspace.
CONFIG_DRM_VKMS=y
#
# The test boot: U-Boot loads this kernel with an initrd = Android's boot ramdisk + a small pre-init (rdinit) that
# attaches two disk image files with GPT partitions as loop0 / loop1 (Android's init, patched, links the named
# partitions of the loop devices listed in androidboot.boot_devices under /dev/block/by-name), then runs Android's
# first-stage init. The board's own tokens first (this string replaces rk3026_onyx_rc2.config's), then the test
# boot's; CMDLINE_EXTEND puts all of them after the bootloader's. vkms.pref_*: the panel's 1072x1448 as vkms'
# preferred mode. androidboot.console=tty1: Android's console shell stays off ttyGS0 (the kernel console here).
CONFIG_CMDLINE="console=tty0 console=ttyGS0,115200 fbcon=font:TER16x32 vt.global_cursor_default=0 vt.default_red=255,170,0,170,0,170,0,0,85,255,85,255,85,255,85,0 vt.default_grn=255,0,170,85,0,0,170,0,85,85,255,255,85,85,255,0 vt.default_blu=255,0,0,0,170,170,170,0,85,85,85,85,255,255,255,0 rdinit=/rc2/preinit printk.devkmsg=on androidboot.hardware=opi_pc_go androidboot.selinux=permissive androidboot.boot_devices=loop0,loop1 androidboot.force_normal_boot=1 androidboot.slot_suffix=_a androidboot.verifiedbootstate=orange androidboot.vbmeta.device_state=unlocked androidboot.console=tty1 androidboot.serialno=rc2a10go0001 vkms.pref_xres=1072 vkms.pref_yres=1448 drm_kms_helper.fbdev_emulation=0"
CONFIG_CMDLINE_EXTEND=y
