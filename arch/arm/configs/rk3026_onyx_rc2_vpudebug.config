# One test boot of the VPU on the shared CMA area: a debug addition applied
# after rk3026_onyx_rc2.config and rk3026_onyx_rc2_local.config. Not a board
# setting; never part of a branch that is merged or proposed.
#
# DMA-API debugging: every coherent and streaming mapping is tracked, misuse
# is reported, and debugfs dma-api/ (error_count, dump) shows what a driver
# still holds after it is unloaded.
CONFIG_DMA_API_DEBUG=y
