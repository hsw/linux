# Measurement fragment, applied after rk3026_onyx_rc2.config:
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config rk3026_irqtime.config
# Account hard-IRQ and softirq time on their own. Without it the tick-based
# accounting charges an interrupt to whatever the tick lands in, so the CPU
# that a PIO host spends copying its FIFO in the hard IRQ handler barely
# shows in /proc/stat. Not meant for everyday kernels (one sched_clock read
# per IRQ entry and exit).
CONFIG_IRQ_TIME_ACCOUNTING=y
