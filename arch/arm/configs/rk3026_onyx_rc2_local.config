# Local settings of this tree's RC2 kernels, applied after rk3026_onyx_rc2.config:
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config rk3026_onyx_rc2_local.config
# Not part of the board configuration proposed upstream; keep it out of any
# series. Everything here is a development aid.
#
# Account hard-IRQ and softirq time on their own, so /proc/stat shows the CPU an
# interrupt handler takes (a PIO SD/eMMC host copies its FIFO there). Costs one
# sched_clock read per IRQ entry and exit.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Cheap memory diagnostics: per-area CMA counters in debugfs (used, maxchunk,
# bitmap) and sysfs (alloc_pages_success/fail), at no cost on the hot path, and
# page_owner, which allocates nothing until the kernel is booted with
# page_owner=on (for a CMA allocation that fails with -EBUSY on a page that
# cannot be migrated).
CONFIG_CMA_DEBUGFS=y
CONFIG_CMA_SYSFS=y
CONFIG_PAGE_OWNER=y
