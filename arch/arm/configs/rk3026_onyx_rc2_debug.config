# ONYX BOOX Robinson Crusoe 2, debug kernel. A second fragment, applied after
# rk3026_onyx_rc2.config (last wins):
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config rk3026_onyx_rc2_debug.config
#
# It adds dynamic checkers only: the kernel it produces differs from the normal
# one by these options and nothing else, but not only in symbols -- KASAN,
# lockdep and kmemleak change memory use and timing, and lockdep changes
# behaviour, so a comparison against the normal kernel says so.
#
# The SD card boots it through U-Boot slot b, not through the stage2 hand-off:
# with this much debug code the inflated Image no longer fits below the stage2
# initrd address 0x62000000 (check_image.py, and the lockdep card of 2026-10-19
# already failed that gate). CONFIG_PROVE_LOCKING selects DEBUG_SPINLOCK,
# DEBUG_MUTEXES, DEBUG_RWSEMS, DEBUG_LOCK_ALLOC and TRACE_IRQFLAGS, so none of
# them is written here.

# Out-of-bounds and use-after-free, in both the linear map and vmalloc.
CONFIG_KASAN=y
CONFIG_KASAN_VMALLOC=y

# Sampling detector on the SLUB allocator: low overhead, catches the heap
# errors a sampling run happens to land on. It selects STACKTRACE.
CONFIG_KFENCE=y

# Leaks, read through /sys/kernel/debug/kmemleak (debugfs is already on).
CONFIG_DEBUG_KMEMLEAK=y

# Lock correctness: lockdep on every lock class, plus sleeping in atomic
# context. PROVE_LOCKING selects DEBUG_SPINLOCK.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# Slab poisoning and redzones on top of KASAN, for the free path KASAN does not
# track (the SLUB_DEBUG default flags stay "ZPU").
CONFIG_SLUB_DEBUG=y

# Symbols and line numbers in the reports (the build is not size-bound).
CONFIG_DEBUG_INFO=y

# The EBC KUnit suite, on the book. =m, not =y: rk3026_onyx_rc2.config sets
# CONFIG_DRM_RK3026_EBC=m and the test symbol is tristate with "depends on
# DRM_RK3026_EBC" (drivers/gpu/drm/rockchip/Kconfig), so =y would be lowered by
# olddefconfig and the fragment survival check would fail the build. As a
# module it is not run by the boot itself: load rk3026-ebc.ko (the initramfs
# does) and then rk3026_ebc_kunit_test.ko, and the KTAP result appears in dmesg.
# A bare CONFIG_KUNIT=y builds the framework only; the suite symbol is what runs
# it. KUNIT_ALL_TESTS stays off so that the EBC suite is the only one.
CONFIG_KUNIT=y
CONFIG_DRM_RK3026_EBC_KUNIT_TEST=m
