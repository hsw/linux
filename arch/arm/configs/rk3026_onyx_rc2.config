# Help: ONYX BOOX Robinson Crusoe 2 (on top of rk3026_c67ml_slim_defconfig)
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config
# with rk3026-onyx-rc2.dtb appended to the zImage.

# Stock-style loader: ATAG list in r2, DTB appended, cmdline from the
# ATAG, gzip initrd.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# No cpufreq: vdd_arm is a fixed regulator.
# CONFIG_CPU_FREQ is not set

# The ACT8931 rails are fixed regulators in the dts.
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# PMICs and panel are not described yet; no NAND on this board.
# CONFIG_MFD_ACT8945A is not set
# CONFIG_REGULATOR_ACT8945A is not set
# CONFIG_BATTERY_ACT8945A is not set
# CONFIG_REGULATOR_ACT8865 is not set
# CONFIG_MFD_TPS65185 is not set
# CONFIG_REGULATOR_TPS65185 is not set
# CONFIG_DRM_RK3026_EBC is not set
# CONFIG_MTD is not set

# Keep the image small: the decompressor relocates itself past the
# inflated kernel and must stay below the loader's initrd at 0x62000000.
# CONFIG_NET is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set

# ramoops in the reserved window, uncompressed.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set

# Console over the OTG port: CDC ACM serial gadget, ttyGS0.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_USB_GADGET=y
# CONFIG_USB_ETH is not set
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# Status LED triggers.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_PANIC=y

# microSD only, ext4 on it.
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y

# gpio-keys for the power, page and back keys.
CONFIG_KEYBOARD_GPIO=y

# Debugging aids.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_PRINTK_TIME=y
# /dev/mem, also for registers that drivers claim.
CONFIG_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
