# Test-only fragment: the kernel memory leak detector, for a leak check of
# driver load/unload cycles. Applied after the board and local fragments:
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config \
#        rk3026_onyx_rc2_local.config rk3026_kmemleak.config
# Not for any series. It changes memory use and timing only; the code under
# test is the same.
#
# On at boot (not default-off), read and driven through
# /sys/kernel/debug/kmemleak (debugfs is already on).
CONFIG_DEBUG_KMEMLEAK=y
# CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF is not set

# The static pool for the allocations made before kmemleak is up. The default
# is 16000 objects; a kmemleak kernel on this SoC booted with 15840 of them
# still free, so the default leaves a wide margin. Set explicitly so the
# check that every line of this fragment survived pins it.
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000

# No scan thread: the test scans when it wants a result (echo scan), so no
# background scan runs in the middle of a load/unload cycle or prints a report
# of its own.
# CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN is not set
