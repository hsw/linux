# ONYX BOOX Robinson Crusoe 2, first light. A fragment on top of the C67ML
# defconfig:
#   make rk3026_c67ml_slim_defconfig rk3026_onyx_rc2.config
# Pair it with rk3026-onyx-rc2.dtb appended to the zImage. The initramfs
# (CONFIG_INITRAMFS_SOURCE) is set by the build, it is not part of this file.

# Stock-style loader: ATAG list in r2, DTB appended, cmdline from the ATAG.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# The RK3026 Cortex-A9 has VFPv3 and NEON, and an armhf userspace uses them
# from its first instruction. rk3026_c67ml_slim_defconfig asks for
# KERNEL_MODE_NEON without VFP, so that request is dropped and a hard-float
# /init dies with SIGILL.
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y

# /tmp and /dev/shm for the userspace (busybox, KOReader); SHMEM alone
# gives no mountable tmpfs.
CONFIG_TMPFS=y

# cpufreq core, statistics and governors for power work, with no driver:
# rk3026.dtsi gives the cores a 600/504 MHz OPP table and there is no
# cpu-supply here, so cpufreq-dt would probe and register a policy, and any
# governor other than performance would reprogram the APLL through code that
# hung the C67ML (the notes in rk3026.dtsi). The CPU stays where the DDR init
# left it (600 MHz). The performance default keeps it there once a driver is
# allowed.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# CONFIG_CPUFREQ_DT is not set
# CONFIG_CPUFREQ_DT_PLATDEV is not set
# The base defconfig's SCMI driver comes back with CPU_FREQ; no SCMI here.
# CONFIG_ARM_SCMI_CPUFREQ is not set

# cpuidle: the teo governor next to menu (menu stays the default).
CONFIG_CPU_IDLE_GOV_TEO=y

# Suspend debugging: /sys/power/pm_test, pm_debug_messages, per-device PM
# attributes.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# The ACT8931's rails stay fixed regulators in the DT, and the one write it
# needs (LDO4, the panel logic rail) comes from /init. The read-only ACT8931
# driver is a module, loaded by hand: it reports the rails and the charger
# state and never writes the PMU. The drivers that do write it (act8945a,
# act8865) stay off. There is no MTD on this board (the NFC pads are the
# eMMC data lines).
# CONFIG_MFD_ACT8945A is not set
# CONFIG_REGULATOR_ACT8945A is not set
# CONFIG_BATTERY_ACT8945A is not set
# CONFIG_REGULATOR_ACT8865 is not set
CONFIG_REGULATOR_ACT8931=m
# CONFIG_MFD_TPS65185 is not set
# CONFIG_MTD is not set
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Size. The loader puts the zImage at 0x60408000 and the initrd at 0x62000000;
# the decompressor inflates to 0x60008000 and, since that overlaps, first
# moves itself past the end of the inflated kernel. With the C67ML set
# (27 MB Image + 11 MB zImage) that copy runs over 0x62000000. Nothing here
# needs media or sound yet (DRM: the E Ink panel; networking: system devices;
# both below).
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set

# E Ink panel: the EBC DRM driver with fbdev emulation, the mxcfb ioctls and
# the framebuffer console, the TPS65185 EPD PMIC (rails, VCOM, the panel
# thermometer as the epd-thermal zone). The EBC driver is a module: the panel
# logic rail (ACT8931 LDO4) is off at power-on, and /init switches it on and
# only then loads the module, so neither the driver's boot RESET nor fbcon
# scans the panel with that rail off.
CONFIG_MODULES=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_RK3026_EBC=m
CONFIG_DRM_RK3026_EBC_MXCFB=y
CONFIG_REGULATOR_TPS65185=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Kernel messages on the panel (tty0) beside the USB console; ttyGS0 is named
# again last so it stays the preferred console (/dev/console once /init has
# created it) and the shell's port. The text cursor is
# off: a blinking cursor (200 ms) would refresh the panel all the time and keep
# its rails up. The palette is the kernel's default with entry 7 (the default
# foreground, the background once the console is in reverse video) at full
# white instead of 0xaaaaaa, so the panel shows black on white, not on grey.
# Appended to what the loader passes.
CONFIG_CMDLINE="console=tty0 console=ttyGS0,115200 fbcon=font:TER16x32 vt.global_cursor_default=0 vt.default_red=0,170,0,170,0,170,0,255,85,255,85,255,85,255,85,255 vt.default_grn=0,0,170,85,0,0,170,255,85,85,255,255,85,85,255,255 vt.default_blu=0,0,0,0,170,170,170,255,85,85,85,85,255,255,255,255"
CONFIG_CMDLINE_EXTEND=y

# Log that survives a reset: ramoops in the reserved DDR window, kept
# uncompressed so another kernel can read it raw.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set

# OTG port: a configfs gadget that /init builds at boot, CDC ACM (ttyGS0,
# console) plus mass storage (the whole microSD for the host) plus CDC NCM
# (a USB network link to the host: macOS binds NCM without a driver, also
# inside a composite gadget). The ttyGS0 console registers when /init
# creates the ACM function and replays the log buffer then. A built-in
# legacy gadget would take the UDC first.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_USB_GADGET=y
# CONFIG_USB_ETH is not set
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_U_SERIAL_CONSOLE=y

# kexec: the next test kernel without a reset (CPU1 goes offline first).
CONFIG_KEXEC=y

# Status LED: heartbeat from the kernel, timer/pattern from userspace, a fast
# blink on panic.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_PANIC=y

# microSD only.
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y

CONFIG_KEYBOARD_GPIO=y

# Diagnostics for the first runs.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEVMEM=y
# Lets /dev/mem read registers that a driver holds (GPIO0 data register).
# CONFIG_IO_STRICT_DEVMEM is not set

# Watchdog driver built in for the autonomous card tests; the wdt node stays
# disabled in the DT until the loader side is settled, so nothing binds yet.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_DW_WATCHDOG=y

# Power-off: gpio-poweroff drops the power hold (GPIO1_A2); without it
# poweroff only halts.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_GPIO=y

# Touchscreen: the Cypress TrueTouch Gen4 controller on i2c2 (0x24), read
# through evdev; uinput for injected test input.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_TOUCHSCREEN_CYTTSP4=y

# System devices (rk3026-onyx-rc2-sys.dtsi): fuel gauge with the USB charger
# presence from the GRF, RTC alarm, front light, cover switch, vibrator,
# and Wi-Fi (uinput: touchscreen block above).
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_CW2015=y
CONFIG_CHARGER_GPIO=y
CONFIG_GPIO_SYSCON=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_VIBRA=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
# Wi-Fi: RTL8723BU on the USB host port, rtl8xxxu over mac80211; IPv4 only.
# The networking core is built in (~1 MB); cfg80211, mac80211 and rtl8xxxu
# (~5 MB of Image when built in) are modules that the root file system loads
# (MODULES: E Ink panel block above).
# The inflated kernel now ends above U-Boot's kernel_addr_r (0x61000000), so
# a zImage loaded there first moves itself past it (check_image.py --load).
# rtl8xxxu takes rtlwifi/rtl8723bu_nic.bin from /lib/firmware when userspace
# powers the module.
CONFIG_MODULE_UNLOAD=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
# CONFIG_RTL_CARDS is not set
# Only the Realtek USB driver: the base defconfig's other Wi-Fi drivers stay out.
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# NET brings back the base defconfig's networking: no Ethernet, DSA, CAN, NFC,
# Bluetooth (the combo's BT half is a later step), NFS, USB network adapters
# or USB network gadget functions other than NCM (in the gadget block above).
# CONFIG_ETHERNET is not set
# CONFIG_PHYLIB is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_NET_FAILOVER is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_NET_DSA is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_BT is not set
# CONFIG_QRTR is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_IP_PNP is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# and POWER_SUPPLY the base's chargers of other boards.
# CONFIG_BATTERY_CPCAP is not set
# CONFIG_CHARGER_CROS_PCHG is not set
