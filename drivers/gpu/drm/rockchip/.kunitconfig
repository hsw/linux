# The NEON blit needs ARM with kernel-mode NEON; run it a second time with
# --arch=arm --kconfig_add CONFIG_VFP=y --kconfig_add CONFIG_NEON=y
# --kconfig_add CONFIG_KERNEL_MODE_NEON=y (qemu virt is a Cortex-A15), and
# expect no skipped case there.

CONFIG_KUNIT=y
CONFIG_COMPILE_TEST=y
CONFIG_OF=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_DEBUG_FS=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_RK3026_EBC=y
CONFIG_DRM_RK3026_EBC_MXCFB=y
CONFIG_DRM_RK3026_EBC_KUNIT_TEST=y
