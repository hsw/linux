// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree for ONYX BOOX Robinson Crusoe 2 (MC_Kepler_R2)
 *
 * Hardware:
 *  - SoC: Rockchip RK3026 (dual-core Cortex-A9)
 *  - RAM: 512 MiB DDR3
 *  - Storage: eMMC, microSD
 *  - Display: 6.0" E Ink ED060KD1 (1448x1072) on the EBC, TPS65185
 *  - PMIC: ACT8931
 *
 * Booted from microSD by a loader that:
 *  - passes ATAGs with this DTB appended, as the stock one does, or this
 *    DTB in r2;
 *  - holds CPU1 in reset;
 *  - drives the power hold (GPIO1_A2) high.
 *
 * Not described yet: eMMC, the ACT8931 and TPS65185 PMICs, EBC and panel,
 * touch, fuel gauge, RTC, Wi-Fi, audio.
 */

/dts-v1/;
#include "rk3026.dtsi"
#include <dt-bindings/input/input.h>

/* The NFC pads are the eMMC data lines; neither is described yet. */
/delete-node/ &emmc;
/delete-node/ &nfc;

/ {
	model = "Onyx Boox Robinson Crusoe 2";
	compatible = "onyx,rc2", "rockchip,rk3026";

	aliases {
		mmc0 = &sdmmc;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>; /* 512 MiB */
	};

	/*
	 * The top 1 MiB is the EBC waveform buffer in the stock layout. The
	 * waveform takes the first 256 KiB, the last 256 KiB is kept for a
	 * loader log, ramoops sits in between.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		waveform@7ff00000 {
			reg = <0x7ff00000 0x40000>;
			no-map;
		};

		ramoops@7ff40000 {
			compatible = "ramoops";
			reg = <0x7ff40000 0x80000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
		};

		loader-log@7ffc0000 {
			reg = <0x7ffc0000 0x40000>;
			no-map;
		};
	};

	cpus {
		enable-method = "rockchip,rk3036-smp";
	};

	/* ACT8931 rails at the voltages the chip holds; no PMIC driver yet */
	vcc_io: regulator-vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io"; /* DCDC1 */
		regulator-min-microvolt = <3400000>;
		regulator-max-microvolt = <3400000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_ddr: regulator-vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr"; /* DCDC2 */
		regulator-min-microvolt = <1350000>;
		regulator-max-microvolt = <1350000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vdd_arm: regulator-vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm"; /* DCDC3 */
		regulator-min-microvolt = <1400000>;
		regulator-max-microvolt = <1400000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_tp: regulator-vcc-tp {
		compatible = "regulator-fixed";
		regulator-name = "vcc_tp"; /* LDO1, touch */
		regulator-min-microvolt = <3100000>;
		regulator-max-microvolt = <3100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_sd: regulator-vcc-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sd"; /* LDO3, microSD */
		regulator-min-microvolt = <3100000>;
		regulator-max-microvolt = <3100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key &page_keys>;

		key-power {
			label = "Power";
			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-pageup {
			label = "Page Up";
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEUP>;
			debounce-interval = <20>;
			wakeup-source;
		};

		key-pagedown {
			label = "Page Down";
			gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEDOWN>;
			debounce-interval = <20>;
			wakeup-source;
		};

		key-back {
			label = "Back";
			gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_BACK>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/*
	 * ACT8931 power hold: low switches the board off on battery. With
	 * USB power the board stays up.
	 */
	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_hold>;
		active-delay-ms = <3000>;
		/* U32_MAX ms: keep the line low until the cable goes */
		timeout-ms = <0xffffffff>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pin>;

		led-0 {
			label = "status";
			gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			panic-indicator;
		};
	};
};

&pinctrl {
	/* External pull-ups; stock leaves the internal pulls off. */
	keys {
		pwr_key: pwr-key {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		page_keys: page-keys {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		led_pin: led-pin {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	power {
		/* GPIO function; the pull stays on, as at reset and on stock */
		pwr_hold: pwr-hold {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};

	sdmmc {
		/*
		 * Card detect: GPIO2_A3 as a GPIO (cd-gpios) instead of the
		 * dtsi's sdmmc_cd, GPIO1_C1, which the other variant uses.
		 */
		sdmmc_cd_pin: sdmmc-cd-pin {
			rockchip,pins = <2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <25000000>;
	cd-gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
	disable-wp;
	fifo-mode;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4 &sdmmc_cd_pin>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&usbphy {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};
