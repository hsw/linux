/*
 * ONYX BOOX Robinson Crusoe 2: system devices that need no PMIC driver.
 *
 * Included at the end of rk3026-onyx-rc2.dts. Wiring from the stock board
 * file of this board (pcb V1.73).
 *
 * The ACT8931 (i2c0 0x5b) is described at the voltages it holds; its
 * driver writes it only within the node's maxima and compiled-in stock
 * limits (see the pmic@5b node), and no node uses its outputs (the rails
 * stay the fixed regulators of the board file). The gauge and the RTC
 * share its bus, and the gauge's charger state comes from the GRF, not
 * from the PMIC.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>

/ {
	/*
	 * USB-only charging: there is no DC-detect pin, and the stock battery
	 * driver takes "charger present" from the OTG controller's bvalid.
	 * The same bit, read from GRF_SOC_STATUS0, says whether a cable
	 * supplies VBUS (host or wall charger alike).
	 */
	usb_charger: usb-charger {
		compatible = "gpio-charger";
		charger-type = "usb-sdp";
		gpios = <&usb_status 0 GPIO_ACTIVE_HIGH>;
	};
};

&grf {
	usb_status: usb-status {
		compatible = "rockchip,rk3026-grf-usb-status";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "otg-bvalid", "otg-linestate0",
				  "otg-linestate1", "otg-iddig";
	};
};

/*
 * CW2015 fuel gauge. Its ALRT line (GPIO1_B1) is not used: the driver
 * polls. With no battery profile here the driver keeps the profile the
 * gauge holds (the stock firmware loaded it; it survives as long as the
 * battery is connected).
 */
&i2c0 {
	battery@62 {
		compatible = "cellwise,cw2015";
		reg = <0x62>;
		power-supplies = <&usb_charger>;
	};
};

/*
 * HYM8563 RTC at i2c0 0x51; it keeps UTC. Its interrupt (GPIO1_B3, level
 * low) is the stock wake source for alarms. The driver's probe clears the
 * STOP bit, masks the alarm and timer interrupts and switches the
 * 32.768 kHz CLKOUT off; the alarm registers are written only when an
 * alarm is set.
 */
&i2c0 {
	rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int>;
		wakeup-source;
	};
};

/*
 * ACT8931 PMU at i2c0 0x5b (driver act8931-regulator, a module loaded by
 * hand). VSEL (GPIO0_A3) is high, as the stock kernel leaves it, so VSET2
 * sets the DCDC outputs. The voltages are the ones the PMU holds on this
 * board (stock regdump, DS Table 6 decode). The driver bounds every VSET
 * write by the output's regulator-max-microvolt, so each maximum is the
 * highest selector the stock kernel sets: DCDC1 0x3b (3.5 V, its VCCIO
 * while Wi-Fi/BT is powered, and what the PMU reads on every mainline
 * boot; 0x3a otherwise), DCDC2 0x1b, DCDC3 0x1c, LDO1-4 0x37. On top of
 * that the RC2 stack compiles the same stock caps into the driver,
 * whatever this node says.
 *
 * Only two outputs get ops: DCDC3 (CPU) can be set, pinned here at its
 * current 1.40 V (minimum = maximum: no regulator consumer can move it);
 * LDO4 (panel logic) can be switched, and stays always-on until the EBC
 * driver takes it as its v3p3-supply: without a consumer the regulator
 * core would switch it off as unused. /init switches it on before the EBC
 * module loads, so binding writes nothing. Every other output is read
 * back only. No suspend state, no supply of another node: DCDC2 is the
 * DDR rail.
 */
&i2c0 {
	pmic@5b {
		compatible = "active-semi,act8931";
		reg = <0x5b>;
		active-semi,vsel-high;

		regulators {
			DCDC_REG1 {	/* VCC_IO, 0x3a; 0x3b with Wi-Fi/BT */
				regulator-min-microvolt = <3400000>;
				regulator-max-microvolt = <3500000>;
			};

			DCDC_REG2 {	/* DDR, 0x1b */
				regulator-min-microvolt = <1350000>;
				regulator-max-microvolt = <1350000>;
			};

			DCDC_REG3 {	/* ARM, 0x1c */
				regulator-min-microvolt = <1400000>;
				regulator-max-microvolt = <1400000>;
			};

			LDO_REG1 {	/* touch, 0x37 */
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
			};

			LDO_REG2 {	/* unused, off, 0x37 */
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
			};

			LDO_REG3 {	/* microSD, 0x37 */
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
			};

			LDO_REG4 {	/* panel logic, 0x37 */
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&pinctrl {
	rtc {
		rtc_int: rtc-int {
			rockchip,pins = <1 RK_PB3 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};
};

/*
 * Front light: PWM0 on GPIO0_D2, duty proportional to brightness, no
 * enable GPIO. The stock driver runs it at 1 kHz (PWM_APB_PRE_DIV 1000,
 * prescaler 2) with 256 linear steps; boot leaves it dark.
 */
/ {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 1000000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <0>;
	};
};

&pwm0 {
	status = "okay";
};

/*
 * Magnet (cover) sensor on GPIO1_B0, no pull; stock turns its falling
 * edge into a power key press. Here it is a lid switch, so userspace sees
 * the state on both edges. Polarity (magnet = low) to be checked.
 * GPIO1_B0 doubles as SPI0_CLK for the panel's flash, which this
 * description never reads.
 *
 * Vibrator on GPIO0_A2, active low (stock timed-gpio "vibrator").
 */
/ {
	gpio-keys-lid {
		compatible = "gpio-keys";
		label = "Lid";
		pinctrl-names = "default";
		pinctrl-0 = <&lid_pin>;

		switch-lid {
			label = "Cover";
			gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <50>;
			wakeup-source;
		};
	};

	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&vibrator_pin>;
	};
};

&pinctrl {
	lid {
		lid_pin: lid-pin {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	vibrator {
		vibrator_pin: vibrator-pin {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * Wi-Fi + Bluetooth: an RTL8723BU module on the host-only USB controller,
 * powered through GPIO1_A5, active low (stock: high = off at boot, low
 * while Wi-Fi or Bluetooth is in use). The switch is left to userspace,
 * as the stock bt_pwr / wifi on-off was: the module stays off until
 * "enabled" is written to /sys/devices/platform/wifi-power/state, then
 * enumerates on the host port (rtl8xxxu loads rtlwifi/rtl8723bu_nic.bin
 * from the root file system at that point).
 */
/ {
	vcc_wifi: regulator-vcc-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wifi";
		regulator-min-microvolt = <3400000>;
		regulator-max-microvolt = <3400000>;
		gpio = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_pwr>;
	};

	wifi-power {
		compatible = "regulator-output";
		vout-supply = <&vcc_wifi>;
	};
};

&pinctrl {
	wifi {
		wifi_pwr: wifi-pwr {
			rockchip,pins = <1 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&usb_host {
	status = "okay";
};
